<Window x:Class="MyCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyCleaner" Height="360" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <StackPanel Margin="20" FlowDirection="RightToLeft">
        <TextBlock Text="MyCleaner" FontSize="24" FontWeight="Bold"/>
        <TextBlock x:Name="StatusText" Text="جاهز" FontSize="14" Margin="0,10,0,10" TextWrapping="Wrap"/>
        <ProgressBar x:Name="Progress" Height="8" Margin="0,0,0,15"/>
        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
            <Button x:Name="ScanBtn" Content="فحص الملفات المؤقتة" Width="180" Height="34" Click="Scan_Click"/>
            <Button x:Name="CleanBtn" Content="تنظيف" Width="120" Height="34" Margin="10,0,0,0" Click="Clean_Click"/>
            <Button x:Name="UpdateBtn" Content="فحص التحديثات" Width="140" Height="34" Margin="10,0,0,0" Click="Update_Click"/>
        </StackPanel>
        <TextBlock x:Name="VersionText" Margin="0,25,0,0" Foreground="Gray"/>
    </StackPanel>
</Window>
